# Copy to .env.local for local work. Vite inlines VITE_* into the bundle at
# BUILD time, so these configure a build — they are not read at runtime, and a
# change means a rebuild.
#
# ⚠ Everything here ends up in the shipped JavaScript. Never put a secret in a
# VITE_ key.

# The CMS API this build talks to.
#   local       http://localhost:4000
  # production  https://iwan-cms-api.vercel.app
VITE_API_URL=https://iwan-cms-api.vercel.app
# VITE_API_URL=http://localhost:4000

# The public site, for the "View the site" link in the sidebar.
VITE_SITE_URL=http://localhost:5173

# What the Upload button refuses before it even tries. Matches the API it
# is pointed at: 10MB against a normal server, 4MB against Vercel, which
# rejects a bigger request body before the function runs.
VITE_MAX_UPLOAD_MB=10
