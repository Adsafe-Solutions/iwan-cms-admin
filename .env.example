# Copy to .env.local and fill in — Vite loads .env.local automatically and it
# is gitignored, unlike this file.

# The CMS API this build talks to.
#   local       http://localhost:4000
#   production  https://iwan-cms-api.vercel.app
VITE_API_URL=http://localhost:4000

# The public site, for the sidebar's "View the site" link.
VITE_SITE_URL=https://iwan.community

# What the Upload button refuses before it even tries — matches the API's own
# limit for whichever host it is pointed at: 10MB against a normal server,
# 4MB against Vercel, which rejects a bigger request body before the function
# runs. See iwan-cms-api's environment-and-secrets skill / README.
VITE_MAX_UPLOAD_MB=10

# ⚠ DOCUMENTED IN THE README, NOT YET WIRED UP IN THE CODE — nothing in src/
# currently reads this variable. The README describes it as a badge beside the
# logo that stops someone editing a dev/staging deploy from mistaking it for
# production; that protection does not exist yet. Setting this here has no
# effect until it is actually implemented. Leave it unset until then, or
# implement it and remove this warning.
VITE_ENV_LABEL=
